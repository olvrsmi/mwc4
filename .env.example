# Copy to .env and fill in. .env is gitignored.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Physics
# ---------------------------------------------------------------------------
# local  model/engine.py in a Python with model/requirements.txt (default)
# fake   deterministic invented trajectories; no Python, no network
# http   the Moth API's qdrive-api-v1 engine, one credit a step
MW_MODEL=http

# Interpreter for the local model. Defaults to model/.venv, then python3 on PATH.
# MW_PYTHON=/path/to/python3

# qdrive-api's src/, which model/engine.py drives. Defaults to
# ../vendor/qdrive-api/src, model/vendor/qdrive-api/src, then
# ../coupling-playground/qdrive-api/src.
# MW_QDRIVE_API_SRC=/path/to/qdrive-api/src

# The Moth API key, for MW_MODEL=http. One or the other; never both in git.
# MW_MOTH_KEY=
# MW_MOTH_KEY_FILE=../moth-api/KEY
# MW_MOTH_API=https://api.mothquantum.com
# MW_MOTH_ENGINE=qdrive-api-v1

# ---------------------------------------------------------------------------
# Telegram (client-telegram only)
# ---------------------------------------------------------------------------
# From @BotFather. Telegram allows exactly ONE long poll per token and a second
# one evicts the first, so a laptop and a server cannot share a bot: make two.
#
# Do NOT put a trailing comment on the same line unless you quote the value -
# an unquoted `TOKEN=123:ABC # prod` used to carry the comment into the token
# and come back as a 401 that looked like a bad token.
# TELEGRAM_BOT_TOKEN=
# The one MW_LOCAL=1 uses instead, so development does not fight the deployed bot.
# TELEGRAM_BOT_TOKEN_LOCAL=
# MW_LOCAL=1

# How long each message waits before it arrives is the copy editor's: set in
# seconds under `pacing:` in core/copy.yaml, per scene and per line. This only
# scales it - 1 plays it as written, 2 at half speed, 0 turns pacing off.
# MW_PACE=1

# Allowlist of Telegram user ids. If set, only these may play. Get an id by
# forwarding a message to @userinfobot.
# MW_ALLOW=123456789,987654321

# ---------------------------------------------------------------------------
# Who is playing (client-http, and the deployed server)
# ---------------------------------------------------------------------------
# Signs the cookie that says which saved game is yours. Any long random string:
#   openssl rand -hex 32
# Left unset, a new one is made at every start and a restart signs everybody
# out. Fine on a laptop, not on a box.
# MW_SECRET=

# The production bot's username, without the @. Needed for the Telegram Login
# Widget to appear at all - and the widget will only sign anyone in on the
# domain you gave BotFather with /setdomain. Getting that wrong fails silently.
# MW_BOT_USERNAME=

# Where the site is, as players reach it. https here is also what makes the
# session cookie Secure, so leave it unset for a plain-HTTP localhost run.
# MW_PUBLIC_URL=https://game.example.com

# Read X-Forwarded-For for the rate limiter. Only set this when a proxy you
# control is the one setting it - exposed directly it is whatever the client
# typed, and one script can wear a new address per request.
# MW_TRUST_PROXY=1

# Where the web client listens. Loopback by default: in production Caddy holds
# the certificate and should be the only thing that can reach the app.
# MW_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# Time, in steps
# ---------------------------------------------------------------------------
# The horizon a world's advertised volatility is measured over, and nothing
# else: a world itself runs until the day's bell ends it. Changing this
# invalidates specs/_stats_cache.json: run model/warmcache.py afterwards.
# MW_STEPS=10
# World steps in a game day, which is the whole of the rope a world has.
# MW_DAY_STEPS=27
# Readouts a chart shows at once. A world can outrun the paper, so the older
# ones age off the left. host/render.mjs rules 14 squares, hence 15 fenceposts.
# MW_CHART_READOUTS=15
# MW_WEEK_DAYS=7
# Steps of watching that restore a spent qubit fully, and how much a night restores.
# MW_REGEN_STEPS=9
# MW_NIGHT_STEPS=9

# ---------------------------------------------------------------------------
# Economy
# ---------------------------------------------------------------------------
# MW_START_BUDGET=1000
# MW_BUDGET_FLOOR=500
# MW_QUOTA=0.10
# MW_WEEK_BONUS=100
# MW_UPGRADE_COST=10
# The leaderboard: the best three single trades, days and weeks the floor has
# ever seen, shared by every player and both clients. It lives in the state
# directory as _leaderboard.json; name a path to put it elsewhere, or set 0 to
# keep it in memory only, which forgets it on restart.
# MW_LEADERBOARD=
# MW_PROBATION=1
# The share of every budget a probation week is handed that its profit must
# clear to pass. 0.05 of seven days at 1,000 is a target of 350, and it moves
# with the budget: a day that clears the quota raises both.
# MW_PROBATION_SHARE=0.05

# ---------------------------------------------------------------------------
# Machinery
# ---------------------------------------------------------------------------
# Also step the world uncoupled while a position is held, for the ghost line
# on the chart. Costs a second model call per held step.
# MW_COUNTERFACTUAL=1
# MW_MODEL_TIMEOUT=120000
# MW_STATE_DIR=host/state
# PORT=5090
# Where copy.yaml and the world specs are read from, if not beside the code.
# MW_COPY=core/copy.yaml
# MW_SPEC_DIR=model/specs
# Rendered charts older than this are swept, and how often that is checked. A
# transcript keeps its last 300 emissions, so older pictures are unreachable.
# MW_SWEEP_DAYS=30
# MW_SWEEP_HOURS=12
# How many saved games are held in memory. Every save writes its file first, so
# dropping one costs a read; the cap is what stops an open game from holding
# every session anybody ever started.
# MW_CACHE=500
