{
  "name": "mackenziewalk",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Office 4B, 6 Mackenzie Walk - a turn-based quantum trading game, renderer agnostic",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "web": "node client-http/server.mjs",
    "fake": "MW_MODEL=fake node server.mjs",
    "moth": "MW_MODEL=http node server.mjs",
    "telegram": "node client-telegram/bot.mjs",
    "doctor": "node test/doctor.mjs",
    "test": "node test/selftest.mjs && node test/auth.mjs && node test/web.mjs && node test/telegram.mjs && node test/mirror.mjs",
    "test:auth": "node test/auth.mjs",
    "test:web": "node test/web.mjs",
    "test:telegram": "node test/telegram.mjs",
    "test:mirror": "node test/mirror.mjs",
    "copy-check": "node test/copy-check.mjs",
    "dryrun": "node test/dryrun.mjs",
    "model-test": "cd model && ${MW_PYTHON:-.venv/bin/python3} selftest.py",
    "warm": "cd model && ${MW_PYTHON:-.venv/bin/python3} warmcache.py"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.60",
    "grammy": "^1.46.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}
